<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Biblioteca | Reginaldo Melo</title>
<meta name="description" content="Biblioteca gratuita de Reginaldo Melo: e-books, materiais e leituras sobre saúde emocional, psicanálise, hipnoterapia, PNL e coaching.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,600;1,500&family=Source+Serif+4:wght@400;600&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --ink: #000000;
  --forest: #123528;
  --forest-light: #1E4F3B;
  --sage: #9A9A9A;
  --paper: #000000;
  --paper-2: #0D0D0D;
  --brass: #B8912B;
  --brass-light: #E3C468;
  --cream-text: #FFFFFF;
  --font-display: 'Fraunces', 'Iowan Old Style', Georgia, serif;
  --font-body: 'Source Serif 4', Georgia, 'Times New Roman', serif;
  --font-utility: 'Inter', -apple-system, sans-serif;
}
*{box-sizing:border-box; margin:0; padding:0;}
body{
  font-family: var(--font-body);
  background: var(--ink);
  color: var(--cream-text);
  line-height:1.6;
}
a{color:inherit;}
.wrap{width:min(1080px,92%); margin:auto;}
h1,h2,h3{font-family:var(--font-display); font-weight:600; line-height:1.15; color:#fff;}

/* ---------- NAV ---------- */
header.nav{
  position: sticky; top:0; z-index:50;
  background: rgba(0,0,0,0.92);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(227,196,104,0.18);
}
.nav-inner{width:min(1180px,92%); margin:auto; display:flex; align-items:center; justify-content:space-between; padding:20px 0;}
.logo{font-family:var(--font-display); font-size:1.25rem; font-weight:600; color:var(--brass-light); text-decoration:none;}
.nav-links{display:flex; gap:32px; font-family:var(--font-utility); font-size:0.85rem;}
.nav-links a{text-decoration:none; color:#fff; opacity:0.75; transition:opacity .2s;}
.nav-links a:hover{opacity:1; color:var(--brass-light);}
@media(max-width:860px){ .nav-links{display:none;} }
.nav-cta{
  font-family: var(--font-utility); font-weight:600; font-size:0.82rem;
  background: var(--forest-light); color:#fff;
  padding:10px 20px; border-radius:2px; text-decoration:none;
}
.nav-cta:hover{background:var(--brass);}

/* ---------- HERO ---------- */
.lib-hero{padding:72px 0 46px; text-align:center; border-bottom:1px solid rgba(227,196,104,0.15);}
.eyebrow{color:var(--brass-light); font-family:var(--font-utility); text-transform:uppercase; letter-spacing:0.18em; font-size:0.72rem; font-weight:700; margin-bottom:16px;}
.lib-hero h1{font-size:clamp(2rem,5vw,3rem); max-width:720px; margin:0 auto 16px;}
.lib-hero p{color:rgba(255,255,255,0.7); max-width:560px; margin:0 auto; font-size:1.05rem;}

/* ---------- GRID ---------- */
.lib-section{padding:56px 0;}
.lib-section + .lib-section{border-top:1px solid rgba(227,196,104,0.1);}
.section-title{display:flex; align-items:baseline; gap:14px; margin-bottom:28px; flex-wrap:wrap;}
.section-title h2{font-size:1.55rem;}
.section-title span{font-family:var(--font-utility); font-size:0.78rem; color:var(--sage); letter-spacing:0.04em;}

.lib-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:24px;}
@media(max-width:900px){ .lib-grid{grid-template-columns:repeat(2,1fr);} }
@media(max-width:620px){ .lib-grid{grid-template-columns:1fr;} }

.lib-card{
  background: var(--ink); border:1px solid rgba(227,196,104,0.22);
  border-radius:4px; overflow:hidden; display:flex; flex-direction:column;
  transition: transform .25s, border-color .25s, box-shadow .25s;
}
.lib-card:hover{transform:translateY(-4px); border-color:var(--brass); box-shadow:0 20px 34px -18px rgba(0,0,0,0.7);}
.lib-cover{
  height:170px; display:flex; align-items:center; justify-content:center;
  background: linear-gradient(135deg, var(--forest), var(--ink));
  font-size:2.4rem;
  border-bottom:1px solid rgba(227,196,104,0.18);
}
.lib-card.locked .lib-cover{background: linear-gradient(135deg, #141414, var(--ink)); color:rgba(255,255,255,0.25);}
.lib-body{padding:22px; display:flex; flex-direction:column; gap:10px; flex:1;}
.lib-tag{
  font-family:var(--font-utility); font-size:0.66rem; text-transform:uppercase; letter-spacing:0.1em;
  color:var(--brass-light); font-weight:700;
}
.lib-card h3{font-size:1.1rem;}
.lib-body p{font-size:0.9rem; color:rgba(255,255,255,0.65); flex:1;}
.lib-btn{
  margin-top:8px; display:inline-flex; align-items:center; justify-content:center; gap:8px;
  font-family:var(--font-utility); font-weight:700; font-size:0.85rem;
  padding:12px 16px; border-radius:2px; text-decoration:none;
  background: linear-gradient(135deg, var(--brass-light), var(--brass)); color:#0A0A0A;
  transition: transform .2s;
}
.lib-btn:hover{transform:translateY(-2px);}
.lib-btn.disabled{
  background:transparent; border:1px dashed rgba(255,255,255,0.25); color:rgba(255,255,255,0.4);
  cursor:default; pointer-events:none;
}

/* ---------- NEWSLETTER / FORM ---------- */
.lib-cta{
  background: var(--paper-2); border:1px solid rgba(227,196,104,0.2); border-radius:6px;
  padding:40px; text-align:center; margin-top:8px;
}
.lib-cta h2{font-size:1.5rem; margin-bottom:10px;}
.lib-cta p{color:rgba(255,255,255,0.65); max-width:520px; margin:0 auto 22px;}

footer{
  background: var(--ink); color:rgba(246,242,231,0.6); padding:44px 0 30px;
  font-family: var(--font-utility); font-size:0.82rem; border-top:1px solid rgba(227,196,104,0.15);
}
.footer-grid{display:flex; justify-content:space-between; flex-wrap:wrap; gap:24px;}
.footer-brand{font-family:var(--font-display); font-size:1.1rem; color:#fff;}
.footer-links{display:flex; gap:24px; flex-wrap:wrap;}
.footer-links a{text-decoration:none; opacity:0.75;}
.footer-links a:hover{opacity:1;}
</style>
</head>
<body>

<header class="nav">
  <div class="nav-inner">
    <a class="logo" href="index.html">Reginaldo Melo</a>
    <nav class="nav-links">
      <a href="index.html#sobre">Sobre</a>
      <a href="index.html#metodo">Método</a>
