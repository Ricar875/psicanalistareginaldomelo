      </div>

    </div>
  </div>
</section>

<section class="lib-section">
  <div class="wrap">
    <div class="section-title">
      <h2>📄 Artigos e PDFs</h2>
      <span>Leitura rápida</span>
    </div>
    <div class="lib-grid">

